.env
.env*
*.pem
credentials

# Data, models, build output
*.csv
*.pkl
*.tar.gz
*.joblib
*.bak
*.backup
logs/
model-check/

# Python / Jupyter clutter
__pycache__/
*.pyc
.ipynb_checkpoints/
